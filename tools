    <!-- Interactive Script for Resizing -->
    <script src="script.js"></script>
    <script>
        let currentImage = null;
        let activePreset = 'photo';

        function setPreset(preset) {
            activePreset = preset;
            document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
            if(preset === 'photo') document.getElementById('btnPhoto').classList.add('active');
            if(preset === 'sign') document.getElementById('btnSign').classList.add('active');
            if(preset === 'custom') document.getElementById('btnCustom').classList.add('active');

            if (currentImage) processImage();
        }

        function handleImageUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            document.getElementById('origSize').innerText = (file.size / 1024).toFixed(1) + " KB";

            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    currentImage = img;
                    document.getElementById('origImg').src = event.target.result;
                    processImage();
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        }

        function processImage() {
            if (!currentImage) return;

            const canvas = document.createElement('canvas');
            let targetWidth, targetHeight, targetKBMin, targetKBMax;

            if (activePreset === 'photo') {
                targetWidth = 350;
                targetHeight = 450;
                targetKBMin = 25;
                targetKBMax = 48;
            } else if (activePreset === 'sign') {
                targetWidth = 320;
                targetHeight = 130;
                targetKBMin = 10;
                targetKBMax = 19;
            } else {
                targetWidth = 600;
                targetHeight = (currentImage.height / currentImage.width) * 600;
                targetKBMin = 60;
                targetKBMax = 95;
            }

            canvas.width = targetWidth;
            canvas.height = targetHeight;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = "#FFFFFF";
            ctx.fillRect(0, 0, targetWidth, targetHeight);
            ctx.drawImage(currentImage, 0, 0, targetWidth, targetHeight);

            // Progressive compression to match KB range
            let quality = 0.85;
            let resultDataUrl = canvas.toDataURL('image/jpeg', quality);

            // Adjust quality
            for (let i = 0; i < 6; i++) {
                let bytes = Math.round((resultDataUrl.length * 3) / 4);
                let currentKB = bytes / 1024;
                if (currentKB > targetKBMax && quality > 0.15) {
                    quality -= 0.15;
                    resultDataUrl = canvas.toDataURL('image/jpeg', quality);
                } else {
                    break;
                }
            }

            const finalBytes = Math.round((resultDataUrl.length * 3) / 4);
            const finalKB = (finalBytes / 1024).toFixed(1);

            document.getElementById('resImg').src = resultDataUrl;
            document.getElementById('resSize').innerText = finalKB + " KB (परफेक्ट)";
            
            const downloadBtn = document.getElementById('downloadBtn');
            downloadBtn.href = resultDataUrl;
            downloadBtn.style.display = 'block';
            document.getElementById('previewArea').style.display = 'grid';
        }
    </script>
